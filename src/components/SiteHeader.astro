---
import { getSite } from "../lib/content";
import { pagePath, withBase } from "../lib/paths";
import SmartImage from "./SmartImage.astro";

const site = await getSite();
const path = pagePath(Astro.url.pathname);
---

<div class="site-chrome">
  <header class="site-header">
    <a class="brand" href={withBase("/")}>
      <SmartImage src={site.portrait} alt={site.name} width={48} height={72} loading="eager" />
      <span class="brand-text">
        <strong>{site.name}</strong>
        {site.taglineLines.map((line) => <span>{line}</span>)}
      </span>
    </a>
  </header>
  <nav class="nav" id="site-nav" aria-label="Menu">
    {
      site.nav.map((item) =>
        item.href === "/" ? (
          <a
            class="nav-home"
            href={withBase(item.href)}
            aria-label={item.label}
            title={item.label}
            aria-current={path === item.href ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 11.2 12 4l8.5 7.2" />
              <path d="M5.8 9.6V20h4.6v-5.4h3.2V20h4.6V9.6" />
            </svg>
          </a>
        ) : (
          <a href={withBase(item.href)} aria-current={path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ),
      )
    }
  </nav>
  <div class="header-actions">
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Switch to light theme"
    >
      <span class="theme-icon theme-icon-sun" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 3v2.2M12 18.8V21M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M3 12h2.2M18.8 12H21M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
        </svg>
      </span>
      <span class="theme-icon theme-icon-moon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M16.4 14.2A6.4 6.4 0 0 1 9.8 7.6 6.6 6.6 0 1 0 16.4 14.2Z"></path>
        </svg>
      </span>
    </button>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      menu
    </button>
  </div>
</div>
