---
/**
 * One shared modal player per page. Any element with `data-video="<embed url>"`
 * opens it on click (the element's href stays as a no-JS / new-tab fallback).
 */
---

<dialog class="video-lightbox" id="video-lightbox" aria-label="Video">
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <div class="video-frame"></div>
</dialog>

<script>
  const dialog = document.getElementById("video-lightbox") as HTMLDialogElement | null;
  const frame = dialog?.querySelector<HTMLElement>(".video-frame");

  function open(src: string, title: string) {
    if (!dialog || !frame) return;
    frame.innerHTML = "";
    const iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.title = title;
    iframe.allow = "autoplay; fullscreen; picture-in-picture; encrypted-media";
    iframe.setAttribute("allowfullscreen", "");
    iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
    frame.appendChild(iframe);
    dialog.showModal();
    document.body.style.overflow = "hidden";
  }

  function close() {
    if (!dialog || !frame) return;
    frame.innerHTML = ""; // stops playback
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-video]").forEach((el) => {
    el.addEventListener("click", (event) => {
      // let modifier clicks / middle clicks open the real page instead
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const src = el.dataset.video;
      if (!src) return;
      event.preventDefault();
      const title = el.querySelector("h2, h3")?.textContent?.trim() || "Video";
      open(src, title);
    });
  });

  dialog?.querySelector(".lightbox-close")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", close);
</script>
