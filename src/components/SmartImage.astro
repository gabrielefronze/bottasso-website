---
import { webpSrc } from "../lib/images";
import { withBase } from "../lib/paths";

interface Props {
  src: string;
  alt: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
}

const { src, alt, loading = "lazy", width, height } = Astro.props;
---

<picture>
  <source type="image/webp" srcset={withBase(webpSrc(src))} />
  <img src={withBase(src)} alt={alt} loading={loading} width={width} height={height} />
</picture>
