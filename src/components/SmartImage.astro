---
import { webpSrc } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
}

const { src, alt, loading = "lazy", width, height } = Astro.props;
---

<picture>
  <source type="image/webp" srcset={webpSrc(src)} />
  <img src={src} alt={alt} loading={loading} width={width} height={height} />
</picture>
