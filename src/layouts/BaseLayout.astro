---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getSite } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
}

const site = await getSite();
const { title, description } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : site.name;
const desc = description ?? site.taglineLines.join(" / ");
const canonical = Astro.url.href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme = stored === "dark" || stored === "light" ? stored : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/portrait-volpina.jpg" type="image/jpeg" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(site.portrait, Astro.url)} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip" href="#content">{site.skipLabel}</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
